-- ESP Folder
local espFolder = Instance.new("Folder", ScreenGui)
espFolder.Name = "ESPFolder"

-- Simple ESP
local function updateESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local esp = espFolder:FindFirstChild("ESP_"..p.Name)
                if espPlayersToggle() then
                    if not esp then
                        esp = Instance.new("BillboardGui")
                        esp.Name = "ESP_"..p.Name
                        esp.Size = UDim2.new(0,100,0,50)
                        esp.Adornee = root
                        esp.AlwaysOnTop = true
                        local txt = Instance.new("TextLabel",esp)
                        txt.Size = UDim2.new(1,0,1,0)
                        txt.BackgroundTransparency = 1
                        txt.TextColor3 = Color3.new(1,0,0)
                        txt.TextScaled = true
                        esp.Parent = espFolder
                    end
                    esp.Adornee = root
                    esp.TextLabel.Text = p.Name.." | "..math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude).." studs"
                elseif esp then
                    esp:Destroy()
                end
            end
        end
    end
end

-- Aim Stick (Head Lock)
local function getClosestTarget()
    local shortest = math.huge
    local closest = nil
    local fov = getFOV()*10
    local mouse = UserInputService:GetMouseLocation()
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
            local head = p.Character.Head
            local pos,onscreen = Camera:WorldToViewportPoint(head.Position)
            if onscreen then
                local dist = (Vector2.new(pos.X,pos.Y)-Vector2.new(mouse.X,mouse.Y)).Magnitude
                if dist<fov and dist<shortest then
                    shortest = dist
                    closest = p
                end
            end
        end
    end
    return closest
end

-- No Clip / Wall Hack
RunService.RenderStepped:Connect(function()
    for _,v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.CanCollide and v.Name ~= "HumanoidRootPart" and v.Name ~= "Baseplate" and v.Name ~= "Floor" then
            if noClipToggle() then
                v.CanCollide = false
            end
        end
    end
end)

-- FPS Counter
local last = tick()
local frames = 0
RunService.RenderStepped:Connect(function()
    frames = frames + 1
    if tick()-last>=1 then
        fpsLabel.Text = "FPS: "..frames
        frames = 0
        last = tick()
    end
end)

-- Main loop
RunService.RenderStepped:Connect(function()
    updateESP()
    if aimStickToggle() or headAimToggle() then
        local target = getClosestTarget()
        if target and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local root = LocalPlayer.Character.HumanoidRootPart
            local head = target.Character.Head
            -- move towards head
            root.CFrame = CFrame.new(root.Position, head.Position)
        end
    end
end)
