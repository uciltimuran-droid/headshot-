-- ESP Logic
local drawings = {}

local function addEsp(player)
    if player == LocalPlayer then return end
    
    local text = Drawing.new("Text")
    text.Visible = false
    text.Color = Color3.fromRGB(255, 255, 255)
    text.Size = 16
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    text.Center = true
    
    drawings[player] = {text = text}
    
    local function updateEsp()
        if not espToggle or not player.Character or not player.Character:FindFirstChild("Humanoid") or player.Character.Humanoid.Health <= 0 or not player.Character:FindFirstChild("Head") or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            text.Visible = false
            return
        end
        
        local rootPos = LocalPlayer.Character.HumanoidRootPart.Position
        local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
        if not targetRoot then
            text.Visible = false
            return
        end
        
        local distance = (rootPos - targetRoot.Position).Magnitude
        local headPos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
        
        if onScreen then
            text.Text = player.Name .. " [" .. math.floor(distance) .. "]"
            text.Position = Vector2.new(headPos.X, headPos.Y - 30)
            text.Visible = true
        else
            text.Visible = false
        end
    end
    
    drawings[player].connection = RunService.RenderStepped:Connect(updateEsp)
end

local function removeEsp(player)
    if drawings[player] then
        drawings[player].text:Remove()
        if drawings[player].connection then
            drawings[player].connection:Disconnect()
        end
        drawings[player] = nil
    end
end

-- Initialize ESP for existing players
for _, player in ipairs(Players:GetPlayers()) do
    addEsp(player)
end

-- Player Added/Removing
Players.PlayerAdded:Connect(addEsp)
Players.PlayerRemoving:Connect(removeEsp)

