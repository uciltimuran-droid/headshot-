-- ESP System (BillboardGui Fallback)
local espObjects = {}
local useBillboards = false

local function cleanupEsp(player)
    if espObjects[player] then
        local esp = espObjects[player]
        if esp.text then
            pcall(function() esp.text:Remove() end)
        elseif esp.billboard then
            pcall(function() esp.billboard:Destroy() end)
        end
        if esp.connection then
            pcall(function() esp.connection:Disconnect() end)
        end
        espObjects[player] = nil
    end
end

local function createEsp(player)
    if player == LocalPlayer then return end
    
    local esp = { text = nil, billboard = nil, connection = nil }
    
    local success, text = pcall(Drawing.new, "Text")
    if success then
        esp.text = text
        esp.text.Color = Color3.fromRGB(255, 255, 255)
        esp.text.Size = 14
        esp.text.Outline = true
        esp.text.OutlineColor = Color3.fromRGB(0, 0, 0)
        esp.text.Center = true
        esp.text.Visible = false
    else
        warn("MXPLOIT: Drawing API failed - " .. tostring(text) .. ". Using BillboardGui.")
        useBillboards = true
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "MXPLOIT_ESP_" .. player.Name
        billboard.Size = UDim2.new(0, 100, 0, 30)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = ScreenGui
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextSize = 10
        label.Font = Enum.Font.Gotham
        label.Text = ""
        label.Parent = billboard
        
        esp.billboard = billboard
    end
    
    espObjects[player] = esp
    
    local function updateEsp()
        if not espEnabled or not player.Character or not player.Character:FindFirstChild("Humanoid") or 
           player.Character.Humanoid.Health <= 0 or not player.Character:FindFirstChild("Head") or 
           not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            if esp.text then
                esp.text.Visible = false
            elseif esp.billboard then
                esp.billboard.Enabled = false
            end
            return
        end
        
        local rootPos = LocalPlayer.Character.HumanoidRootPart.Position
        local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
        if not targetRoot then
            if esp.text then
                esp.text.Visible = false
            elseif esp.billboard then
                esp.billboard.Enabled = false
            end
            return
        end
        
        local distance = (rootPos - targetRoot.Position).Magnitude
        if esp.text then
            local headPos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
            if onScreen then
                esp.text.Text = string.format("%s [%.0fm]", player.Name, distance)
                esp.text.Position = Vector2.new(headPos.X, headPos.Y - 20)
                esp.text.Visible = true
            else
                esp.text.Visible = false
            end
        elseif esp.billboard then
            esp.billboard.Adornee = player.Character.Head
            esp.billboard.Enabled = true
            esp.billboard.TextLabel.Text = string.format("%s [%.0fm]", player.Name, distance)
        end
    end
    
    esp.connection = RunService.RenderStepped:Connect(function()
        pcall(updateEsp)
    end)
end

