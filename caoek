--[[ 
99%W Panel Script for Roblox FPS Game
Features:
- Movable & minimizable panel
- Toggle ESP (players, distance, guns)
- Set WalkSpeed & JumpPower
- Updates enemy distances in ESP every frame
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer

-- UI Creation
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
ScreenGui.Name = "WPanel"

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 280, 0, 350)
MainFrame.Position = UDim2.new(0.05, 0, 0.2, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true

local Header = Instance.new("Frame", MainFrame)
Header.Size = UDim2.new(1, 0, 0, 30)
Header.BackgroundColor3 = Color3.fromRGB(45, 45, 45)

local Title = Instance.new("TextLabel", Header)
Title.Text = "99%W"
Title.Size = UDim2.new(1, -30, 1, 0)
Title.BackgroundTransparency = 1
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextScaled = true
Title.Font = Enum.Font.SourceSansBold
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.Position = UDim2.new(0.05, 0, 0, 0)

local MinimizeButton = Instance.new("TextButton", Header)
MinimizeButton.Text = "-"
MinimizeButton.Size = UDim2.new(0, 30, 1, 0)
MinimizeButton.Position = UDim2.new(1, -30, 0, 0)
MinimizeButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
MinimizeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
MinimizeButton.TextScaled = true

local Content = Instance.new("Frame", MainFrame)
Content.Size = UDim2.new(1, 0, 1, -30)
Content.Position = UDim2.new(0, 0, 0, 30)
Content.BackgroundTransparency = 1

-- Toggles
local function createToggle(name, posY)
    local frame = Instance.new("Frame", Content)
    frame.Size = UDim2.new(1, -10, 0, 30)
    frame.Position = UDim2.new(0, 5, 0, posY)
    frame.BackgroundTransparency = 1

    local button = Instance.new("TextButton", frame)
    button.Size = UDim2.new(0, 50, 1, 0)
    button.Position = UDim2.new(0, 0, 0, 0)
    button.Text = "Off"
    button.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextScaled = true

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.new(0, 60, 0, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Text = name
    label.TextScaled = true
    label.TextXAlignment = Enum.TextXAlignment.Left

    local state = false
    button.MouseButton1Click:Connect(function()
        state = not state
        button.Text = state and "On" or "Off"
        button.BackgroundColor3 = state and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(170, 0, 0)
    end)

    return function() return state end
end

local espPlayersToggle = createToggle("ESP Players & Distance", 5)
local espGunsToggle = createToggle("ESP Guns", 45)

-- WalkSpeed & JumpPower
local WalkSpeedBox = Instance.new("TextBox", Content)
WalkSpeedBox.PlaceholderText = "WalkSpeed"
WalkSpeedBox.Size = UDim2.new(0.45, -5, 0, 30)
WalkSpeedBox.Position = UDim2.new(0, 5, 0, 85)
WalkSpeedBox.ClearTextOnFocus = false

local JumpPowerBox = Instance.new("TextBox", Content)
JumpPowerBox.PlaceholderText = "JumpPower"
JumpPowerBox.Size = UDim2.new(0.45, -5, 0, 30)
JumpPowerBox.Position = UDim2.new(0.5, 0, 0, 85)
JumpPowerBox.ClearTextOnFocus = false

local ApplyButton = Instance.new("TextButton", Content)
ApplyButton.Text = "Apply"
ApplyButton.Size = UDim2.new(1, -10, 0, 30)
ApplyButton.Position = UDim2.new(0, 5, 0, 125)
ApplyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
ApplyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ApplyButton.TextScaled = true

ApplyButton.MouseButton1Click:Connect(function()
    local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        local ws = tonumber(WalkSpeedBox.Text)
        local jp = tonumber(JumpPowerBox.Text)
        if ws then hum.WalkSpeed = ws end
        if jp then hum.JumpPower = jp end
    end
end)

-- Minimize toggle
local minimized = false
MinimizeButton.MouseButton1Click:Connect(function()
    minimized = not minimized
    Content.Visible = not minimized
end)

-- ESP Folder
local espFolder = Instance.new("Folder", ScreenGui)
espFolder.Name = "ESPFolder"

-- ESP Functions
local function createPlayerESP(player)
    if player == localPlayer then return end
    if espFolder:FindFirstChild("ESP_"..player.Name) then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_"..player.Name
    billboard.Adornee = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    billboard.Size = UDim2.new(0, 100, 0, 50)
    billboard.AlwaysOnTop = true
    local text = Instance.new("TextLabel", billboard)
    text.Size = UDim2.new(1,0,1,0)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.new(1,0,0)
    text.TextScaled = true
    billboard.Parent = espFolder
end

local function updatePlayerESP()
    for _, player in pairs(Players:GetPlayers()) do
        if espPlayersToggle() then
            createPlayerESP(player)
            local esp = espFolder:FindFirstChild("ESP_"..player.Name)
            if esp and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                esp.Adornee = player.Character.HumanoidRootPart
                local distance = (localPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                esp.TextLabel.Text = player.Name.." | "..math.floor(distance).." studs"
            end
        else
            if espFolder:FindFirstChild("ESP_"..player.Name) then
                espFolder["ESP_"..player.Name]:Destroy()
            end
        end
    end
end

local function updateGunESP()
    if not espGunsToggle() then
        for _, v in pairs(espFolder:GetChildren()) do
            if v.Name:find("Gun_") then v:Destroy() end
        end
        return
    end

    for _, tool in pairs(workspace:GetDescendants()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Handle") and not espFolder:FindFirstChild("Gun_"..tool.Name) then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "Gun_"..tool.Name
            billboard.Adornee = tool.Handle
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.AlwaysOnTop = true
            local text = Instance.new("TextLabel", billboard)
            text.Size = UDim2.new(1,0,1,0)
            text.BackgroundTransparency = 1
            text.Text = tool.Name
            text.TextColor3 = Color3.new(0,1,0)
            text.TextScaled = true
            billboard.Parent = espFolder
        end
    end
end

-- Render loop
RunService.RenderStepped:Connect(function()
    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        updatePlayerESP()
        updateGunESP()
    end
end)
