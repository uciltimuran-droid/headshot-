-- Instant Steal
createToggle("Instant Steal", function(enabled)
    if enabled then
        local connection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if not remotes then return end
            local stealRemote = remotes:FindFirstChild("Steal") or remotes:FindFirstChild("StealRemote")
            if not stealRemote then return end
            for _, obj in pairs(Workspace:GetChildren()) do
                if obj.Name:find("Brainrot") and obj:FindFirstChild("Owner") and obj.Owner.Value ~= LocalPlayer then
                    char.HumanoidRootPart.CFrame = obj.CFrame * CFrame.new(0, 3, 0)
                    wait(0.2)
                    stealRemote:FireServer(obj)
                    wait(0.5) -- Wait for holding
                    -- Find own base
                    local ownBase = nil
                    for _, base in pairs(Workspace:GetChildren()) do
                        if base:IsA("Model") and base.Name:find("Base") and base:FindFirstChild("Owner") and base.Owner.Value == LocalPlayer then
                            ownBase = base
                            break
                        end
                    end
                    if ownBase then
                        char.HumanoidRootPart.CFrame = ownBase.CFrame * CFrame.new(0, 5, 0)
                        wait(0.5) -- Assume auto-deposit in base proximity
                        -- If remote exists
                        local depositRemote = remotes:FindFirstChild("Deposit") or remotes:FindFirstChild("DepositBrainrot")
                        if depositRemote then
                            depositRemote:FireServer(ownBase)
                        end
                    end
                    break -- One at a time
                end
            end
        end)
        getgenv().instantStealConn = connection
    else
        if getgenv().instantStealConn then
            getgenv().instantStealConn:Disconnect()
        end
    end
end)

-- Anti-Hit
createToggle("Anti-Hit", function(enabled)
    if enabled then
        local char = LocalPlayer.Character
        if char then
            local humanoid = char.Humanoid
            local oldHealth = humanoid.MaxHealth
            local healthConn = humanoid.HealthChanged:Connect(function(health)
                if health < oldHealth then
                    humanoid.Health = humanoid.MaxHealth
                end
                oldHealth = humanoid.Health
            end)
            local velocityConn = RunService.Heartbeat:Connect(function()
                local root = char.HumanoidRootPart
                root.Velocity = Vector3.new(root.Velocity.X * 0.1, root.Velocity.Y, root.Velocity.Z * 0.1) -- Heavy dampen for no bounce
            end)
            getgenv().antiHitConns = {healthConn, velocityConn}
        end
    else
        if getgenv().antiHitConns then
            for _, conn in ipairs(getgenv().antiHitConns) do
                conn:Disconnect()
            end
        end
    end
end)

-- Invisible
createToggle("Invisible", function(enabled)
    local char = LocalPlayer.Character
    if char then
        for _, desc in ipairs(char:GetDescendants()) do
            if desc:IsA("BasePart") or desc:IsA("Decal") or desc:IsA("Texture") then
                desc.Transparency = enabled and 1 or 0
            elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
                desc.Enabled = not enabled
            elseif desc:IsA("Accessory") and desc:FindFirstChild("Handle") then
                desc.Handle.Transparency = enabled and 1 or 0
            end
        end
    end
end)

-- Universal No Clip
createToggle("Universal No Clip", function(enabled)
    if enabled then
        local connection = RunService.Stepped:Connect(function(_, dt)
            local char = LocalPlayer.Character
            if char then
                local root = char.HumanoidRootPart
                for _, part in ipairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
                -- Prevent floor fall
                local rayParams = RaycastParams.new()
                rayParams.FilterDescendantsInstances = {char}
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                local rayResult = Workspace:Raycast(root.Position, Vector3.new(0, -4, 0), rayParams)
                if rayResult then
                    local dist = (root.Position - rayResult.Position).Magnitude
                    if dist < 3 then
                        root.Velocity = Vector3.new(root.Velocity.X, math.max(root.Velocity.Y, 0), root.Velocity.Z) -- No downward velocity
                    end
                end
            end
        end)
        getgenv().noClipConn = connection
    else
        if getgenv().noClipConn then
            getgenv().noClipConn:Disconnect()
        end
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end)

