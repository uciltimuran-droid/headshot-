    local center = UserInputService:GetMouseLocation()
    local radius = (fovSize / 100) * math.min(Camera.ViewportSize.X, Camera.ViewportSize.Y) / 2
    
    fovCircle.Position = center
    fovCircle.Radius = radius
    fovCircle.Visible = aimbotEnabled
    
    -- ESP Updates
    for player, esp in pairs(espObjects) do
        if espEnabled and player.Character and player.Character:FindFirstChild("Head") and 
           LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            
            local headPos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
            if onScreen then
                local distance = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                esp.distance = distance
                
                esp.text.Text = string.format("%s\n%.0fm", player.Name, distance)
                esp.text.Position = Vector2.new(headPos.X, headPos.Y - 40)
                esp.text.Visible = true
            else
                esp.text.Visible = false
            end
        else
            esp.text.Visible = false
        end
    end
    
    -- Ultra-Smooth Aimbot
    if aimbotEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        currentTarget = getBestTarget()
        
        if currentTarget then
            -- Predict movement (advanced)
            local targetPos = currentTarget.Position
            local velocity = currentTarget.Parent:FindFirstChild("HumanoidRootPart") and 
                           currentTarget.Parent.HumanoidRootPart.Velocity or Vector3.new()
            
            -- Simple prediction
            targetPos = targetPos + velocity * 0.1
            
            -- Smooth camera interpolation
            local cameraPos = Camera.CFrame.Position
            local targetCFrame = CFrame.lookAt(cameraPos, targetPos)
            
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, smoothSpeed)
        end
    else
        currentTarget = nil
    end
end)

