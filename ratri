-- FOV Slider Logic
local sliding = false
fovSlider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliding = true
    end
end)

fovSlider.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliding = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
        local percent = math.clamp((input.Position.X - fovSlider.AbsolutePosition.X) / fovSlider.AbsoluteSize.X, 0, 1)
        fovSize = math.floor(percent * 100)
        fovLabel.Text = "🎪 FOV: " .. fovSize .. "%"
        
        local fillSize = UDim2.new(percent, 0, 1, 0)
        TweenService:Create(fovSlider, TweenInfo.new(0.1), {Size = fillSize}):Play()
    end
end)

-- Bulletproof ESP System
local espObjects = {}

local function cleanupEsp(player)
    if espObjects[player] then
        for _, obj in pairs(espObjects[player]) do
            if obj and obj.Remove then obj:Remove() end
        end
        espObjects[player] = nil
    end
end

local function createEsp(player)
    if player == LocalPlayer then return end
    
    local esp = {
        text = Drawing.new("Text"),
        distance = 0
    }
    
    esp.text.Color = Color3.fromRGB(255, 255, 255)
    esp.text.Size = 18
    esp.text.Outline = true
    esp.text.OutlineColor = Color3.fromRGB(0, 0, 0)
    esp.text.Center = true
    esp.text.Visible = false
    
    espObjects[player] = esp
end

-- Ultra-Smooth Aimbot System
local fovCircle = Drawing.new("Circle")
fovCircle.Color = Color3.fromRGB(255, 100, 100)
fovCircle.Thickness = 3
fovCircle.NumSides = 128
fovCircle.Filled = false
fovCircle.Transparency = 0.8
fovCircle.Visible = false

local currentTarget = nil
local targetHistory = {}

local function getBestTarget()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    
    local mousePos = UserInputService:GetMouseLocation()
    local closest = nil
    local closestDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local char = player.Character
        if not char then continue end
        
        local humanoid = char:FindFirstChild("Humanoid")
        local targetPart = char:FindFirstChild(aimTarget)
        if not humanoid or not targetPart or humanoid.Health <= 0 then continue end
        
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if onScreen then
            local screenPoint = Vector2.new(screenPos.X, screenPos.Y)
            local dist = (screenPoint - mousePos).Magnitude
            
            local fovRadius = (fovSize / 100) * math.min(Camera.ViewportSize.X, Camera.ViewportSize.Y) / 2
            if dist < fovRadius and dist < closestDist then
                closestDist = dist
                closest = targetPart
            end
        end
    end
    
    return closest
end

-- Main Render Loop (60 FPS Optimized)
local renderConnection
renderConnection = RunService.RenderStepped:Connect(function()
