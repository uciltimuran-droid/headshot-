-- Fly (Smoothed)
createToggle("Fly", function(enabled)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    if enabled then
        local speed = 50
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bodyVelocity.Parent = root

        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.CFrame = root.CFrame
        bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        bodyGyro.P = 10000
        bodyGyro.D = 1000  -- Add damping for smoother
        bodyGyro.Parent = root

        local keys = {}
        local inputBegan = UserInputService.InputBegan:Connect(function(input)
            keys[input.KeyCode] = true
        end)
        local inputEnded = UserInputService.InputEnded:Connect(function(input)
            keys[input.KeyCode] = false
        end)
        local loop = RunService.RenderStepped:Connect(function(dt)
            local cam = Workspace.CurrentCamera
            local vel = Vector3.zero
            if keys[Enum.KeyCode.W] then vel = vel + cam.CFrame.LookVector end
            if keys[Enum.KeyCode.S] then vel = vel - cam.CFrame.LookVector end
            if keys[Enum.KeyCode.D] then vel = vel + cam.CFrame.RightVector end
            if keys[Enum.KeyCode.A] then vel = vel - cam.CFrame.RightVector end
            if keys[Enum.KeyCode.Space] then vel = vel + Vector3.new(0,1,0) end
            if keys[Enum.KeyCode.LeftControl] then vel = vel - Vector3.new(0,1,0) end
            vel = vel.Unit * speed
            bodyVelocity.Velocity = vel
            bodyGyro.CFrame = cam.CFrame
        end)
        getgenv().flyConns = {inputBegan, inputEnded, loop}
        getgenv().flyInstances = {bodyVelocity, bodyGyro}
    else
        if getgenv().flyConns then
            for _, conn in ipairs(getgenv().flyConns) do
                conn:Disconnect()
            end
        end
        if getgenv().flyInstances then
            for _, inst in ipairs(getgenv().flyInstances) do
                inst:Destroy()
            end
        end
    end
end)

