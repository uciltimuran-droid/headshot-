-- Feature: Instant Steal (Auto steal and deposit)
createToggle("Instant Steal", function(enabled)
    if enabled then
        local connection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            for _, obj in pairs(Workspace:GetChildren()) do
                if obj.Name:match("Brainrot") and obj:FindFirstChild("Owner") and obj.Owner.Value ~= LocalPlayer then
                    -- Teleport to Brainrot
                    char.HumanoidRootPart.CFrame = obj.CFrame * CFrame.new(0, 3, 0)
                    wait(0.1)
                    -- Find steal remote
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
                    local stealRemote = remotes:FindFirstChild("Steal") or remotes:FindFirstChild("StealRemote") or remotes:FindFirstChild("StealBrainrot")
                    if stealRemote and stealRemote:IsA("RemoteEvent") then
                        stealRemote:FireServer(obj)
                    end
                    wait(0.3) -- Wait for holding
                    -- Find own base (assume bases in Workspace.Bases or similar)
                    local ownBase = nil
                    for _, base in pairs(Workspace:GetChildren()) do
                        if base.Name:match("Base") and base:FindFirstChild("Owner") and base.Owner.Value == LocalPlayer then
                            ownBase = base
                            break
                        end
                    end
                    if ownBase then
                        -- Teleport to base
                        char.HumanoidRootPart.CFrame = ownBase.CFrame * CFrame.new(0, 5, 0) -- Adjust to deposit area
                        wait(0.3) -- Assume auto-deposit when in base
                        -- If needed, fire deposit remote
                        local depositRemote = remotes:FindFirstChild("Deposit") or remotes:FindFirstChild("DepositBrainrot")
                        if depositRemote then
                            depositRemote:FireServer(ownBase)
                        end
                    end
                    break -- Steal one at a time to avoid spam
                end
            end
        end)
        getgenv().instantStealConn = connection
    else
        if getgenv().instantStealConn then
            getgenv().instantStealConn:Disconnect()
        end
    end
end)

-- Feature: Anti-Hit (Godmode with no knockback)
createToggle("Anti-Hit", function(enabled)
    if enabled then
        local char = LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then
                local oldHealth = humanoid.Health
                local healthConn = humanoid.HealthChanged:Connect(function(health)
                    if health < oldHealth then
                        humanoid.Health = humanoid.MaxHealth
                        char.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0) -- Prevent bounce
                    end
                    oldHealth = humanoid.Health
                end)
                local velocityConn = RunService.Heartbeat:Connect(function()
                    if humanoid.Health < humanoid.MaxHealth then
                        humanoid.Health = humanoid.MaxHealth
                    end
                    char.HumanoidRootPart.Velocity = Vector3.new(char.HumanoidRootPart.Velocity.X * 0.5, char.HumanoidRootPart.Velocity.Y, char.HumanoidRootPart.Velocity.Z * 0.5) -- Dampen knockback
                end)
                getgenv().antiHitConns = {healthConn, velocityConn}
            end
        end
    else
        if getgenv().antiHitConns then
            for _, conn in ipairs(getgenv().antiHitConns) do
                conn:Disconnect()
            end
        end
    end
end)

-- Feature: Invisible (Full, including face and billboards)
createToggle("Invisible", function(enabled)
    local char = LocalPlayer.Character
    if char then
        if enabled then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = 1
                elseif part:IsA("Decal") and part.Name == "face" then
                    part.Transparency = 1
                elseif part:IsA("BillboardGui") then
                    part.Enabled = false
                elseif part:IsA("Accessory") then
                    if part:FindFirstChild("Handle") then
                        part.Handle.Transparency = 1
                    end
                end
            end
        else
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = 0
                elseif part:IsA("Decal") and part.Name == "face" then
                    part.Transparency = 0
                elseif part:IsA("BillboardGui") then
                    part.Enabled = true
                elseif part:IsA("Accessory") then
                    if part:FindFirstChild("Handle") then
                        part.Handle.Transparency = 0
                    end
                end
            end
        end
    end
end)

-- Feature: Universal No Clip (with floor support via raycast)
createToggle("Universal No Clip", function(enabled)
    if enabled then
        local connection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                local root = char.HumanoidRootPart
                for _, part in ipairs(char:GetChildren()) do
                    if part:IsA("BasePart") and part ~= root then
                        part.CanCollide = false
                    end
                end
                -- Raycast for floor to prevent falling
                local ray = Ray.new(root.Position, Vector3.new(0, -4, 0))
                local hit, pos = Workspace:FindPartOnRayWithIgnoreList(ray, {char})
                if hit then
                    -- If floor detected, adjust Y if needed
                    if (root.Position.Y - pos.Y) < 3 then
                        root.Velocity = Vector3.new(root.Velocity.X, 0, root.Velocity.Z) -- Stop falling
                    end
                else
                    -- No floor, allow free movement
                end
            end
        end)
        getgenv().noClipConn = connection
    else
        if getgenv().noClipConn then
            getgenv().noClipConn:Disconnect()
        end
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end)

