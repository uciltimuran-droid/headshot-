-- Aim FOV Slider
local fovLabel = Instance.new("TextLabel", Content)
fovLabel.Text = "Aim FOV: 50%"
fovLabel.Size = UDim2.new(1, -10, 0, 20)
fovLabel.Position = UDim2.new(0, 5, 0, 285)
fovLabel.BackgroundTransparency = 1
fovLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
fovLabel.TextScaled = true
fovLabel.TextXAlignment = Enum.TextXAlignment.Left

local fovSlider = Instance.new("TextBox", Content)
fovSlider.PlaceholderText = "0-100"
fovSlider.Size = UDim2.new(1, -10, 0, 30)
fovSlider.Position = UDim2.new(0, 5, 0, 310)
fovSlider.ClearTextOnFocus = false
fovSlider.Text = "50"

local function getFOV()
    local val = tonumber(fovSlider.Text)
    if not val then val = 50 end
    return math.clamp(val,0,100)
end

-- ESP Folder
local espFolder = Instance.new("Folder", ScreenGui)
espFolder.Name = "ESPFolder"

-- ESP Functions
local function createPlayerESP(player)
    if player == localPlayer then return end
    if espFolder:FindFirstChild("ESP_"..player.Name) then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_"..player.Name
    billboard.Adornee = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    billboard.Size = UDim2.new(0, 100, 0, 50)
    billboard.AlwaysOnTop = true
    local text = Instance.new("TextLabel", billboard)
    text.Size = UDim2.new(1,0,1,0)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.new(1,0,0)
    text.TextScaled = true
    billboard.Parent = espFolder
end

local function updatePlayerESP()
    for _, player in pairs(Players:GetPlayers()) do
        if espPlayersToggle() then
            createPlayerESP(player)
            local esp = espFolder:FindFirstChild("ESP_"..player.Name)
            if esp and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                esp.Adornee = player.Character.HumanoidRootPart
                local distance = (localPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                esp.TextLabel.Text = player.Name.." | "..math.floor(distance).." studs"
            end
        else
            if espFolder:FindFirstChild("ESP_"..player.Name) then
                espFolder["ESP_"..player.Name]:Destroy()
            end
        end
    end
end

local function updateGunESP()
    if not espGunsToggle() then
        for _, v in pairs(espFolder:GetChildren()) do
            if v.Name:find("Gun_") then v:Destroy() end
        end
        return
    end

    for _, tool in pairs(workspace:GetDescendants()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Handle") and not espFolder:FindFirstChild("Gun_"..tool.Name) then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "Gun_"..tool.Name
            billboard.Adornee = tool.Handle
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.AlwaysOnTop = true
            local text = Instance.new("TextLabel", billboard)
            text.Size = UDim2.new(1,0,1,0)
            text.BackgroundTransparency = 1
            text.Text = tool.Name
            text.TextColor3 = Color3.new(0,1,0)
            text.TextScaled = true
            billboard.Parent = espFolder
        end
    end
end

-- Aim Functions with FOV
local function getClosestTarget(headOnly)
    local closestPlayer = nil
    local shortestDistance = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local fovRadius = getFOV() * 10 -- scale for screen pixels

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local part = headOnly and player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(mousePos.X, mousePos.Y)).Magnitude
                    if distance < fovRadius and distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- Aim Stick Loop
RunService.RenderStepped:Connect(function()
    if aimStickToggle() or headAimToggle() then
        local headOnly = headAimToggle()
        local target = getClosestTarget(headOnly)
        if target then
            local part = headOnly and target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local delta = Vector2.new(screenPos.X, screenPos.Y) - UserInputService:GetMouseLocation()
                    local moveAmount = delta * 0.5
                    local virtualInput = game:GetService("VirtualInputManager")
                    virtualInput:SendMouseMoveEvent(moveAmount.X, moveAmount.Y)
                end
            end
        end
    end
end)

-- No Clip / Wall Hack
RunService.RenderStepped:Connect(function()
    if noClipToggle() then
        for _, part in pairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = false
            end
        end
    end
end)

-- Update FPS
local lastTime = tick()
local frameCount = 0
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - lastTime >= 1 then
        fpsLabel.Text = "FPS: "..frameCount
        frameCount = 0
        lastTime = now
    end
end)

-- Main Render Loop for ESP
RunService.RenderStepped:Connect(function()
    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        updatePlayerESP()
        updateGunESP()
    end
end)
