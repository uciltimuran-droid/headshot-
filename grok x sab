-- Other Useful Things: Add Fly
createToggle("Fly", function(enabled)
    if enabled then
        local speed = 50
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.new(0,0,0)
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Parent = LocalPlayer.Character.HumanoidRootPart

        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro.P = 9000
        bodyGyro.Parent = LocalPlayer.Character.HumanoidRootPart

        local keys = {W = false, A = false, S = false, D = false, Space = false, LeftControl = false}

        local inputBegan = UserInputService.InputBegan:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.W then keys.W = true end
            if input.KeyCode == Enum.KeyCode.A then keys.A = true end
            if input.KeyCode == Enum.KeyCode.S then keys.S = true end
            if input.KeyCode == Enum.KeyCode.D then keys.D = true end
            if input.KeyCode == Enum.KeyCode.Space then keys.Space = true end
            if input.KeyCode == Enum.KeyCode.LeftControl then keys.LeftControl = true end
        end)

        local inputEnded = UserInputService.InputEnded:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.W then keys.W = false end
            if input.KeyCode == Enum.KeyCode.A then keys.A = false end
            if input.KeyCode == Enum.KeyCode.S then keys.S = false end
            if input.KeyCode == Enum.KeyCode.D then keys.D = false end
            if input.KeyCode == Enum.KeyCode.Space then keys.Space = false end
            if input.KeyCode == Enum.KeyCode.LeftControl then keys.LeftControl = false end
        end)

        local loop = RunService.RenderStepped:Connect(function()
            local cam = workspace.CurrentCamera
            local vel = Vector3.new(0,0,0)

            if keys.W then vel = vel + cam.CFrame.LookVector end
            if keys.S then vel = vel - cam.CFrame.LookVector end
            if keys.D then vel = vel + cam.CFrame.RightVector end
            if keys.A then vel = vel - cam.CFrame.RightVector end
            if keys.Space then vel = vel + Vector3.new(0,1,0) end
            if keys.LeftControl then vel = vel - Vector3.new(0,1,0) end

            bodyVelocity.Velocity = vel * speed
            bodyGyro.CFrame = cam.CFrame
        end)

        getgenv().flyConns = {inputBegan, inputEnded, loop}
        getgenv().flyInstances = {bodyVelocity, bodyGyro}
    else
        for _, conn in ipairs(getgenv().flyConns or {}) do
            conn:Disconnect()
        end
        for _, inst in ipairs(getgenv().flyInstances or {}) do
            inst:Destroy()
        end
    end
end)

-- Other: ESP (Wallhack for players)
createToggle("ESP", function(enabled)
    if enabled then
        local function addESP(player)
            if player ~= LocalPlayer and player.Character then
                local highlight = Instance.new("Highlight")
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0
                highlight.Parent = player.Character
                highlight.Adornee = player.Character
            end
        end
        for _, player in ipairs(Players:GetPlayers()) do
            addESP(player)
        end
        local conn = Players.PlayerAdded:Connect(addESP)
        getgenv().espConn = conn
    else
        if getgenv().espConn then
            getgenv().espConn:Disconnect()
        end
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character and player.Character:FindFirstChildOfClass("Highlight") then
                player.Character.Highlight:Destroy()
            end
        end
    end
end)

