-- Helper function to create Toggle Button
local function createToggle(name, callback)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Size = UDim2.new(1, 0, 0, 30)
    ToggleFrame.BackgroundTransparency = 1
    ToggleFrame.Parent = ContentFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.7, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextSize = 16
    Label.Font = Enum.Font.SourceSans
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ToggleFrame

    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Size = UDim2.new(0.3, 0, 1, 0)
    ToggleButton.Position = UDim2.new(0.7, 0, 0, 0)
    ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    ToggleButton.Text = "OFF"
    ToggleButton.TextColor3 = Color3.fromRGB(255, 0, 0)
    ToggleButton.TextSize = 16
    ToggleButton.Parent = ToggleFrame

    local enabled = false
    ToggleButton.MouseButton1Click:Connect(function()
        enabled = not enabled
        if enabled then
            ToggleButton.Text = "ON"
            ToggleButton.TextColor3 = Color3.fromRGB(0, 255, 0)
        else
            ToggleButton.Text = "OFF"
            ToggleButton.TextColor3 = Color3.fromRGB(255, 0, 0)
        end
        callback(enabled)
    end)

    return ToggleFrame
end

-- Helper function to create Slider/Input for numbers
local function createInput(name, default, callback)
    local InputFrame = Instance.new("Frame")
    InputFrame.Size = UDim2.new(1, 0, 0, 30)
    InputFrame.BackgroundTransparency = 1
    InputFrame.Parent = ContentFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.5, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextSize = 16
    Label.Font = Enum.Font.SourceSans
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = InputFrame

    local TextBox = Instance.new("TextBox")
    TextBox.Size = UDim2.new(0.3, 0, 1, 0)
    TextBox.Position = UDim2.new(0.5, 0, 0, 0)
    TextBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextBox.TextSize = 16
    TextBox.Text = tostring(default)
    TextBox.Parent = InputFrame

    local ApplyButton = Instance.new("TextButton")
    ApplyButton.Size = UDim2.new(0.2, 0, 1, 0)
    ApplyButton.Position = UDim2.new(0.8, 0, 0, 0)
    ApplyButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    ApplyButton.Text = "Apply"
    ApplyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    ApplyButton.TextSize = 16
    ApplyButton.Parent = InputFrame

    ApplyButton.MouseButton1Click:Connect(function()
        local value = tonumber(TextBox.Text)
        if value then
            callback(value)
        end
    end)

    return InputFrame
end

